<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- CloudKit is a network client. Without this the Mac app syncs nothing
	     and says nothing about why. -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Import and export. A sandboxed app may touch exactly the files the
	     user picked in the open or save panel and nothing else, which is the
	     whole of what this needs: it reads a chosen .json and writes one. No
	     folder access, no bookmarks, nothing kept after the panel closes. -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<key>com.apple.developer.aps-environment</key>
	<string>development</string>
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.robotex.workout-aicode</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
</dict>
</plist>
